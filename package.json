{
  "name": "docs-as-code-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Docs-as-code starter: Docusaurus + GitHub Actions + linting",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "init": "node scripts/init.mjs",
    "lint:md": "markdownlint-cli2 \"docs/**/*.{md,mdx}\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"docs/**/*.{md,mdx}\"",
    "check": "npm run lint:md && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "^3.9.0",
    "@docusaurus/preset-classic": "^3.9.0",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.0",
    "markdownlint-cli2": "^0.24.0"
  },
  "browserslist": {
    "production": [">0.5%", "not dead", "not op_mini all"],
    "development": ["last 3 chrome version", "last 3 firefox version", "last 5 safari version"]
  },
  "engines": {
    "node": ">=20.0"
  }
}
